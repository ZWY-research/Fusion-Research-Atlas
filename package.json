{
  "name": "fusion-research-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate:data": "node --experimental-strip-types scripts/validate-data.ts",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/model.test.ts",
    "test:browser": "playwright test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
